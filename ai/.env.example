# Valeurs factices — copier en .env (jamais commité) et adapter.
# Voir docs/contrat.md §8 pour INGEST_TOKEN (même jeton que celui généré côté api/.env).

# Identifiant du boîtier surveillé, utilisé dans le payload d'alerte (contrat §3.2)
DEVICE_ID=SX-003

# Webcam USB branchée sur ce PC Serveur Local (0 = première caméra détectée)
CAMERA_INDEX=0
FRAME_WIDTH=640
FRAME_HEIGHT=480

# Backend de détection : "yolo" (YOLOv8-tiny, ultralytics) ou "hog" (OpenCV, plan B sans
# téléchargement de poids si la table n'a pas Internet)
DETECTOR_BACKEND=yolo
MODEL_PATH=yolov8n.pt
CONF_THRESHOLD=0.5

# Anti-rafale : une alerte INTRUDER publiée au plus toutes les N secondes
ALERT_COOLDOWN_S=30

# API Sentinel-X (contrat §4) — POST /alerts uniquement, jeton INGEST
API_URL=http://192.168.10.1:8080/api/v1
INGEST_TOKEN=remplacer-par-le-meme-jeton-que-api/.env

# Serveur MJPEG local (contrat §6 : GET http://<PC Serveur Local>:5000/video_feed)
STREAM_HOST=0.0.0.0
STREAM_PORT=5000

# Budget de traitement par frame avant avertissement dans les logs (contrat Vision Intelligente)
MAX_FRAME_MS=100

# --- Maintenance Prédictive (predictive/) ---

# Groupe (construit le topic sentinel/g3/telemetry, contrat §1)
GROUP_ID=g3

# Broker MQTT, compte "ai" en lecture seule sur telemetry (contrat §2 et dev/mosquitto/acl)
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=ai
MQTT_PASSWORD=remplacer-par-MQTT_AI_PASSWORD-de-dev/.env
MQTT_CLIENT_ID=ai-g3
# CA locale pour mqtts:// (docs/tls.md), ignorée en mqtt://
MQTT_CA_FILE=

# Fenêtres du pipeline features -> Isolation Forest (en nombre d'échantillons telemetry,
# ~2 s/échantillon, contrat §2) :
#   SLOPE_WINDOW  : historique utilisé pour calculer une pente (dérive lente)
#   TRAIN_WINDOW  : taille de la fenêtre d'entraînement du modèle
#   SCORING_GAP   : échantillons récents EXCLUS de l'entraînement (empêche un incident en
#                   cours de s'auto-normaliser pendant qu'il se développe)
#   REFIT_EVERY   : réentraîner le modèle tous les N nouveaux échantillons
SLOPE_WINDOW=10
TRAIN_WINDOW=90
SCORING_GAP=15
REFIT_EVERY=5

# Proportion attendue d'anomalies dans la fenêtre d'entraînement (paramètre natif
# scikit-learn IsolationForest, pas un seuil capteur)
CONTAMINATION=0.05

# Anti-rafale : il faut N notations anormales consécutives avant de publier, puis un
# cooldown entre deux alertes (nom distinct de ALERT_COOLDOWN_S ci-dessus : cadences
# différentes pour vision/ et predictive/, qui partagent pourtant ce même .env)
CONSEC_REQUIRED=3
PREDICT_ALERT_COOLDOWN_S=60

# Score de sévérité (0..1) à partir duquel une anomalie est publiée en CRITICAL plutôt
# que WARNING
CRIT_THRESHOLD=0.85
