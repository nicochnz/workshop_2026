# Copier en .env (jamais commité). Mots de passe de DEV uniquement.
MQTT_ESP_PASSWORD=change-me-esp
MQTT_API_PASSWORD=change-me-api
MQTT_AI_PASSWORD=change-me-ai
MQTT_MONITOR_PASSWORD=change-me-monitor

# PostgreSQL de dev (base `sentinel`, utilisateur `sentinel`)
POSTGRES_PASSWORD=change-me-db

# --- TLS (docs/tls.md). Certificats : ./scripts/generate-certs.sh ---
# Listener 1883 en clair : fallback temporaire de la démo. Phase 3 : off.
MQTT_PLAIN_LISTENER=on
# Connexion API → broker. Mode cible : mqtts://mosquitto:8883
# Fallback démo (problème TLS) : mqtt://mosquitto:1883
API_MQTT_URL=mqtts://mosquitto:8883
# Origines autorisées pour le WebSocket : HTTP :8080 (fallback) et HTTPS (proxy).
API_ALLOWED_ORIGINS=http://localhost:8080,https://localhost,http://192.168.10.1:8080,https://192.168.10.1

# Reverse proxy HTTPS (profil "https")
PROXY_HTTPS_PORT=443
PROXY_HTTP_PORT=80
AI_VIDEO_UPSTREAM=http://host.docker.internal:5000
