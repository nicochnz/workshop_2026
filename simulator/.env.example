# Copier en .env (jamais commité)
# Mode cible MQTTS (certificats : ../scripts/generate-certs.sh, voir docs/tls.md)
MQTT_URL=mqtts://localhost:8883
MQTT_CA_FILE=../certs/public/ca.crt
# Fallback démo en clair : MQTT_URL=mqtt://localhost:1883 (MQTT_CA_FILE ignoré)
MQTT_USERNAME=esp
MQTT_PASSWORD=change-me-esp
MQTT_CLIENT_ID=sx-003-sim
GROUP_ID=g3
DEVICE_ID=SX-003

# Seuils (contrat §3.2)
GAS_WARN=400
GAS_CRIT=700
PRESENCE_CM=80
ALERT_COOLDOWN_S=30
