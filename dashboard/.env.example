# Copier en .env.local (jamais commité). Variables lues au BUILD (NEXT_PUBLIC_ = visibles côté navigateur).

# URL de l'API. En dev : l'API tourne à part (PORT de api/.env).
# En production : laisser VIDE → même origine que le dashboard servi par l'API.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Flux vidéo de l'IA. Vide → http://<hôte du dashboard>:5000/video_feed
NEXT_PUBLIC_VIDEO_URL=
