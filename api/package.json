{
  "name": "sentinel-api",
  "version": "1.0.0",
  "private": true,
  "description": "API Sentinel-X : ingestion MQTT, PostgreSQL, REST, WebSocket",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/contract.test.ts test/http.test.ts test/ingest.test.ts test/watchdog.test.ts test/realtime.test.ts test/tls.test.ts"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "mqtt": "^5.16.0",
    "pg": "^8.16.3",
    "ws": "^8.18.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.15.6",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
